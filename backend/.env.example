# Copy to .env for local runs, or set these in the Render dashboard. NEVER commit real secrets.
CORS_ORIGINS=https://YOUR-DEPLOYED-FRONTEND.example,http://localhost:5173
USER_AGENT=RaahiSafetyApp/0.1 (your-email@example.com)

# Free automatic alerts via Telegram (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=pick-a-long-random-string

# Optional (paid / trial-limited)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_CALL_PRIMARY=0
CONTROL_ROOM_WEBHOOK_URL=
